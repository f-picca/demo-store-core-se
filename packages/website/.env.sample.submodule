SITE_URL=http://localhost:3000/
NEXT_PUBLIC_CL_CLIENT_ID=

# path is relative to 'packages/website/'
NEXT_PUBLIC_JSON_DATA_FOLDER=../../../data/json/

# ─── Live content-source toggle (Sanity ⇄ Contentful) ───────────────────────
# See content-source-toggle-spec.md. All optional: with these unset the app
# always serves NEXT_PUBLIC_JSON_DATA_FOLDER (Sanity), so nothing breaks.
NEXT_PUBLIC_JSON_DATA_FOLDER_CONTENTFUL=
EDGE_CONFIG=
VERCEL_API_TOKEN=
VERCEL_EDGE_CONFIG_ID=
VERCEL_TEAM_ID=
VERCEL_EDGE_CONFIG_ITEM_KEY=activeContentSource
CONTENT_SOURCE_ADMIN_SECRET=
# Source served when Edge Config has no value: "sanity" (default) or "contentful".
CONTENT_SOURCE_DEFAULT=
# Set to "on" to show the on-store floating switcher (writes open, no secret).
NEXT_PUBLIC_SHOW_CONTENT_SWITCHER=
